# Port server (default: 8000)
PORT=8000

# API Key Google Gemini (Ambil gratis di https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model default (gemini-2.5-flash / gemini-2.0-flash / gemini-3.8-flash-high)
GEMINI_MODEL=gemini-2.5-flash

# Email rahasia Blogger (Didapat dari Setelan Blogger -> Email -> Publikasikan postingan menggunakan email)
# Format: username.katakunci@blogger.com
BLOGGER_EMAIL=namablog.katakuncirahasia@blogger.com

# Akun Gmail Anda yang dipakai untuk mengirim email ke Blogger
GMAIL_USER=emailanda@gmail.com

# Password Aplikasi Google 16 karakter (Bukan password akun biasa)
# Buat di https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Token WhatsApp Gateway Fonnte (Ambil di https://fonnte.com/)
FONNTE_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Nomor WhatsApp Owner (Hanya nomor ini yang bisa memberi perintah, kosongkan jika bebas)
# Contoh: 6281234567890
OWNER_NUMBER=6281234567890
